<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>display-toggle</AssemblyName>
    <RootNamespace>DisplayToggle</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>display-toggle.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Release builds pass -p:Version=X.Y.Z; anything with a '-' suffix is a dev build, older than every release. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!-- The xUnit project lives underneath this one; keep its sources out of the app's glob. -->
  <ItemGroup>
    <Compile Remove="DisplayToggle.Tests/**" />
    <None Remove="DisplayToggle.Tests/**" />
    <EmbeddedResource Remove="DisplayToggle.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DisplayToggle.Tests" />
  </ItemGroup>

</Project>
